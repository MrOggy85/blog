{
  "name": "blog-cloudflare",
  "private": true,
  "description": "Deploy tooling for the Cloudflare Workers build. Runs inside the image from ./Dockerfile, never on the host.",
  "scripts": {
    "build": "deno run --allow-read --allow-write=../dist --allow-env --allow-net ../scripts/prerender.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "deno": "2.6.8",
    "typescript": "5.9.3",
    "wrangler": "4.162.0"
  }
}
